\citation{Cohen1960}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Checksum Self-Computation Reliability: Deterministic Checker Replaces Same-Model Judge}{11}{subsection.5.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Agreement between the new deterministic, zero-LLM-call mod-9 checker and a freshly re-run LLM judge on the same 70 paired checksum-critique traces. Raw agreement is 77.1\%, but Cohen's kappa of $-0.12$ indicates worse-than-chance agreement once each method's own error-flagging base rate is accounted for, motivating the deterministic checker as the new primary reliability estimate (9.6\% error rate, 30/312 parseable traces) over the prior same-model-judge figure (15.4\%, 80 traces).}}{11}{figure.4}\protected@file@percent }
\newlabel{fig:fig4}{{4}{11}{Agreement between the new deterministic, zero-LLM-call mod-9 checker and a freshly re-run LLM judge on the same 70 paired checksum-critique traces. Raw agreement is 77.1\%, but Cohen's kappa of $-0.12$ indicates worse-than-chance agreement once each method's own error-flagging base rate is accounted for, motivating the deterministic checker as the new primary reliability estimate (9.6\% error rate, 30/312 parseable traces) over the prior same-model-judge figure (15.4\%, 80 traces)}{figure.4}{}}
\citation{Madaan2023,Huang2023,Kamoi2024,Stechly2024}
